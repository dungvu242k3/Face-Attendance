# Copy this file to .env and replace every placeholder with local values.
APP_ENV=development
FLASK_DEBUG=false
SECRET_KEY=replace-with-at-least-32-random-characters

DB_NAME=face_db
DB_USER=postgres
DB_PASSWORD=replace-with-database-password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer
# DB_SSLROOTCERT=/absolute/path/to/ca.crt
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10

ADMIN_USERNAME=admin
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('change-this-password'))"
ADMIN_PASSWORD_HASH=replace-with-werkzeug-password-hash
# ADMIN_PASSWORD is a development-only migration fallback.
# ADMIN_PASSWORD=replace-with-admin-password

# Haar is a dependency-free local fallback. Set DETECTOR_BACKEND=yolo only
# after providing a valid face-specific YOLO checkpoint.
DETECTOR_BACKEND=haar
YOLO_MODEL_PATH=models/face_detector.pt
LIVENESS_MODEL_PATH=models/best_model.pth
# Production must set SHA-256 hashes for every loaded model.
# YOLO_MODEL_SHA256=
# LIVENESS_MODEL_SHA256=
DEVICE=auto
YOLO_CONFIDENCE=0.5
# Set this only when the custom detector contains multiple classes.
# YOLO_FACE_CLASS_IDS=0
RECOGNITION_THRESHOLD=0.6
LIVENESS_REAL_CLASS=1
LIVENESS_THRESHOLD=0.5

MAX_IMAGE_BYTES=5242880
MAX_IMAGE_PIXELS=4000000
MAX_IMAGE_DIMENSION=4096
DUPLICATE_WINDOW_SECONDS=60
CHECKIN_DEADLINE_HOUR=9
CHECKIN_DEADLINE_MINUTE=0
CHECKOUT_DEADLINE_HOUR=18
CHECKOUT_DEADLINE_MINUTE=0
APP_TIMEZONE=Asia/Ho_Chi_Minh
CORS_ORIGINS=http://localhost:8000
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT_SECONDS=1800
ADMIN_HOST=127.0.0.1
USER_HOST=127.0.0.1
# Use Redis in production, for example redis://localhost:6379/0.
RATELIMIT_STORAGE_URI=memory://
